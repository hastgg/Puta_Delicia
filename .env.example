# Copia este archivo como ".env" y cambia los valores. NUNCA subas el .env a GitHub ni lo compartas.
PORT=3000

# --- Claves de acceso: SOLO se usan la primera vez ---
# Al primer arranque el servidor las guarda con hash en la base de datos; después las puedes BORRAR de este archivo.
# Luego se cambian desde Admin → Seguridad. Si no quieres escribirlas aquí, usa:  npm run reset-admin
ADMIN_PASSWORD=                # Contraseña del dueño: mín. 10 caracteres con mayúscula, minúscula, número y símbolo
STAFF_PIN=                     # PIN de caja: solo números, mín. 6, sin combinaciones obvias (nada de 123456 ni 111111)
CORS_ORIGIN=*                  # En producción: la URL de tu sitio, ej. https://tuapp.com
MINUTOS_ENTRE_VISITAS=0        # Anti doble-escaneo, ej. 30. Con 0 queda desactivado
SIMULACION=true                # true = las notificaciones solo se simulan
CALIFICACION_MINUTOS=60
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.mongodb.net/

# Clave que cifra WhatsApp, correo y fecha de nacimiento. Genérala con:  node scripts/generar-clave.js
# ⚠️ Guarda una copia aparte (gestor de contraseñas): sin ella los datos cifrados no se pueden leer.
DATA_KEY=

# En el servidor real (Render/Railway):
# NODE_ENV=production
# Cuántos proxies hay delante del servidor (1 en Render/Railway)
# TRUST_PROXY=1
