{
  "name": "pd-bbq-backend",
  "version": "2.0.0",
  "description": "Backend del club de fidelidad Puta Delicia BBQ House (Express + MongoDB Atlas)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vendor": "node scripts/vendor.js",
    "clave": "node scripts/generar-clave.js --agregar",
